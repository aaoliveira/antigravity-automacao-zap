# ============================================================================
# CONFIGURAÇÕES DE AMBIENTE — ANTIGRAVITY WHATSAPP AUTOMATION SAAS
# ============================================================================

# AMBIENTE DE EXECUÇÃO
NODE_ENV=development
PORT=3000
FRONTEND_PORT=3001
DOMAIN=seudominio.com.br

# ============================================================================
# BANCO DE DADOS (POSTGRESQL 16)
# ============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=antigravity_automacao_zap
POSTGRES_PORT=5435
# URL de conexão (Usar 'postgres:5432' dentro de containers ou 'localhost:5435' no host)
DATABASE_URL="postgresql://postgres:postgres_dev_password@localhost:5435/antigravity_automacao_zap?schema=public"

# ============================================================================
# FILAS DISTRIBUÍDAS E CACHE (REDIS 7)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6382
REDIS_PASSWORD=

# ============================================================================
# AUTENTICAÇÃO E SEGURANÇA CRIPTOGRÁFICA
# ============================================================================
# Chave JWT para assinatura de tokens de acesso (mínimo 32 caracteres)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_auth
JWT_EXPIRES_IN=1d

# Chave mestra AES-256-GCM para criptografia de credenciais (exatamente 64 hex / 32 bytes)
# Para gerar uma chave forte: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ============================================================================
# WHATSAPP GATEWAY (EVOLUTION API V2)
# ============================================================================
EVOLUTION_PORT=8080
EVOLUTION_SERVER_URL=http://localhost:8080
EVOLUTION_API_KEY=evolution_dev_global_api_key_change_in_prod

# ============================================================================
# FRONTEND (NEXT.JS 15)
# ============================================================================
# URL base que o frontend usará para se comunicar com a API do backend
NEXT_PUBLIC_API_URL=http://localhost:3000
