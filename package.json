{
  "name": "antigravity-automacao-zap",
  "version": "1.0.0",
  "description": "SaaS Multi-tenant de Automação Conversacional WhatsApp com Visual Flow Builder",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:infra": "docker compose up postgres redis evolution-api -d",
    "docker:stop:apps": "docker compose stop backend frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "test": "npm run test --workspace=backend",
    "test:e2e": "npm run test:e2e --workspace=backend",
    "test:frontend": "npm run test --workspace=frontend",
    "db:migrate": "npm run prisma:migrate --workspace=backend",
    "db:generate": "npm run prisma:generate --workspace=backend",
    "db:seed": "npm run prisma:seed --workspace=backend"
  },
  "keywords": [
    "whatsapp",
    "automation",
    "flow-builder",
    "evolution-api",
    "typebot",
    "n8n",
    "saas",
    "nestjs"
  ],
  "author": "Antigravity Engineering Team",
  "license": "UNLICENSED"
}
